# Environment Variables for Wally Backend

# App Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wally_ecommerce?schema=public"

# JWT Authentication
JWT_SECRET="wally_super_secret_jwt_access_key_2026_enterprise_level_protection"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="wally_super_secret_jwt_refresh_key_2026_enterprise_level_protection"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Redis Cache & Queues (Optional / Configurable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage (Local, Cloudinary or AWS S3)
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"

# Stripe / Payment Gateway (Optional placeholders)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
